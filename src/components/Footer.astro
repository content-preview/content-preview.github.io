---
import { SITE } from '@config/site';
---

<footer class="site-footer">
  <div class="shell footer-main">
    <div class="footer-about">
      <a class="brand brand-footer" href="/">
        <img src="/logo.jpeg" alt="" width="58" height="58" />
        <span>Global Spellbound <small>Initiative</small></span>
      </a>
      <p>Community Pride Starts with Children.</p>
      <p class="footer-mission">Learn Lead Grow</p>
    </div>
    <div>
      <h2>Explore</h2>
      <ul class="footer-links">
        <li><a href="/about/">About GSI</a></li>
        <li><a href="/programs/">Programs</a></li>
        <li><a href="/get-involved/">Get Involved</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </div>
    <div>
      <h2>Contact</h2>
      <ul class="footer-links">
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li><a href="tel:+15713559287">{SITE.phone}</a></li>
        <li>Virginia, United States</li>
      </ul>
    </div>
  </div>
  <div class="shell footer-bottom">
    <p>&copy; {new Date().getFullYear()} {SITE.author}. All rights reserved.</p>
    <p>Global Spellbound Initiative is an IRS-recognized 501(c)(3) nonprofit.</p>
  </div>
</footer>
