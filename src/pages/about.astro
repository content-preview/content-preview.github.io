---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="About GSI | Global Spellbound Initiative">
  <section class="page-hero">
    <div class="shell">
      <p class="eyebrow eyebrow-gold">About Global Spellbound Initiative</p>
      <h1>Helping young people develop the confidence and skills to pursue their potential.</h1>
      <p>
        GSI is a Virginia-based, IRS-recognized 501(c)(3) nonprofit, tax-exempt organization
        focused on literacy, education and youth leadership.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="shell content-grid">
      <div>
        <p class="eyebrow">Our Mission</p>
        <h2>Empower children and communities through learning.</h2>
        <p class="lead">
          To empower children and communities through literacy, education, leadership development,
          and global educational collaboration.
        </p>
      </div>
      <div class="vision-card">
        <p class="eyebrow">Our Vision</p>
        <h2>A world where every child has the confidence, skills and opportunity to learn, lead and contribute.</h2>
      </div>
    </div>
  </section>
  <section class="section section-warm">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Our Approach</p>
        <h2>Learning rooted in community.</h2>
      </div>
      <div class="approach-list">
        <article><span>01</span><div><h3>Start with literacy</h3><p>Strengthen reading, spelling, vocabulary and expression.</p></div></article>
        <article><span>02</span><div><h3>Build confidence</h3><p>Create opportunities for participation, practice and achievement.</p></div></article>
        <article><span>03</span><div><h3>Work with communities</h3><p>Involve families, educators and trusted local hosts.</p></div></article>
        <article><span>04</span><div><h3>Expand opportunity</h3><p>Connect learning with mentorship and educational pathways.</p></div></article>
        <article><span>05</span><div><h3>Learn and improve</h3><p>Listen to families and assess programs as they develop.</p></div></article>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell founder-profile">
      <img
        class="founder-photo"
        src="/abiye-tekle.jpeg"
        alt="Abiye Tekle, founder of Global Spellbound Initiative"
        width="828"
        height="1104"
        loading="lazy"
        decoding="async"
      />
      <div class="founder-bio">
        <p class="eyebrow">Founder</p>
        <h2>Abiye Tekle</h2>
        <p>
          Abiye Tekle is the founder of Global Spellbound Initiative, Ethiopian Spelling Bee and
          Ethiopian American Spelling Bee, and a co-founder of African Spelling Bee. His experience
          includes community tutoring and mentoring in the Washington, DC area and the development
          of spelling and literacy initiatives in Ethiopia. Through GSI, he aims to connect this
          experience with a broader platform for children's learning and leadership.
        </p>
      </div>
    </div>
  </section>
  <section class="section section-navy">
    <div class="shell content-grid">
      <div>
        <p class="eyebrow eyebrow-gold">Our Next Chapter</p>
        <h2>Beginning in the DMV, with a wider vision.</h2>
      </div>
      <p>
        GSI's initial North American program development focuses on Washington, DC, Maryland and
        Virginia, with a phased vision for other U.S. communities and Canada. Ethiopia is the
        planned first international expansion. Updates will be shared as arrangements and programs
        are established.
      </p>
    </div>
  </section>
</BaseLayout>
